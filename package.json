{
  "name": "phaser-webpack-template",
  "version": "1.3.0",
  "main": "index.js",
  "scripts": {
    "start": "webpack serve --mode development",
    "build": "webpack --mode production",
    "typecheck": "tsc --noEmit",
    "atlas": "node atlas.js",
    "assets": "node assets-config.js",
    "storybook": "webpack serve --mode development --config webpack.storybook.js",
    "build-storybook": "webpack --mode production --config webpack.storybook.js",
    "predeploy": "npm run build-storybook",
    "deploy": "git add docs && git commit -m \"Deploy docs to GitHub Pages\" && git push",
    "yandex": "npm run build && sdk-dev-proxy -p ./dist --dev-mode=true",
    "yandex-dev-mode": "npm run build && sdk-dev-proxy -p ./dist --dev-mode=true"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Simple Webpack template for Phaser",
  "dependencies": {
    "@kvisaz/phaser-sugar": "^1.1.8",
    "@types/ysdk": "^1.2.0",
    "free-tex-packer-core": "^0.3.4",
    "phaser": "3.90.0",
    "phaser3-rex-plugins": "^1.80.15"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^22.1.0",
    "@typescript-eslint/eslint-plugin": "^8.0.1",
    "@typescript-eslint/parser": "^8.0.1",
    "@yandex-games/sdk-dev-proxy": "^0.0.2",
    "copy-webpack-plugin": "^12.0.2",
    "esbuild-loader": "^4.2.2",
    "eslint": "8.57.0",
    "html-webpack-plugin": "^5.6.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.4",
    "typescript": "^5.9.3",
    "webfontloader": "^1.6.28",
    "webpack": "^5.93.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4"
  }
}
